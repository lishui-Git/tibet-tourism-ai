# =============================================================================
#  环境变量样例文件（.env.example）
#  用法：复制为 .env 后按本机实际情况填写。.env 已被 .gitignore 排除，不会入库。
#        cp .env.example .env      （Linux/macOS）
#        copy .env.example .env    （Windows CMD）
#  约束：本文件是唯一允许入库的配置样例，禁止把真实口令/API Key 写进本文件。
#        配置读取统一入口：app/config.py（NR-M-01）。
#
#  【命名约定 · 重要】
#  应用自有配置统一使用 APP_ 前缀。原因：本文件会被开发工具（如 DSH）与 Flask
#  一并读取，部分变量名被工具保留给「启动环境」独占（例如 DEEPSEEK_BASE_URL），
#  写进 .env 会导致工具拒绝启动。app/config.py 对无前缀旧名仍做兼容读取，
#  因此也可以把值放进真正的进程环境变量。
# =============================================================================

# ---------------------------------------------------------------------------
# 一、数据库（MySQL 8）
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 真实口令只填在 .env 中，不要提交；此处留空占位
DB_PASSWORD=
DB_NAME=tibet_review
DB_CHARSET=utf8mb4

# ---------------------------------------------------------------------------
# 二、DeepSeek 官方 API（阶段五/六 才会实际调用，阶段一仅占位）
#     注意：本组变量必须带 APP_ 前缀，见文件头说明。
# ---------------------------------------------------------------------------
# 申请地址：https://platform.deepseek.com/ ；未填写时，所有生成类功能必须降级而非报错（NR-R-05）
APP_DEEPSEEK_API_KEY=
APP_DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名以详细设计说明书 §15 为准
APP_DEEPSEEK_MODEL=deepseek-chat
APP_DEEPSEEK_TIMEOUT=60
# 并发与重试（详细设计 §7.2：并发 3–5，重试最多 2 次）
APP_DEEPSEEK_MAX_CONCURRENCY=3
APP_DEEPSEEK_MAX_RETRY=2

# ---------------------------------------------------------------------------
# 三、应用与数据路径
# ---------------------------------------------------------------------------
APP_FLASK_HOST=127.0.0.1
APP_FLASK_PORT=5000
APP_FLASK_DEBUG=1

# 数据源目录（只读，BR-11：禁止覆盖原始数据）
APP_DATA_DIR=数据采集
# 最终数据集文件名（冻结件，只读）
APP_FINAL_DATASET=旅游评论数据集_最终版.csv
# 辅助清单（只读）
APP_SPOT_SOURCE_FILE=景点来源标注.csv
APP_DUP_LIST_FILE=内容重复清单.csv

# 清洗/导入产物目录（不覆盖原始数据，写成新文件）
APP_OUTPUT_DIR=data

# 日志目录
APP_LOG_DIR=logs
